# ============================================================
# DEPENDENCIES
# ============================================================

# Node.js dependencies installed by npm/yarn/pnpm
node_modules/


# ============================================================
# VITE BUILD OUTPUT
# ============================================================

# Production build generated by Vite
dist/


# ============================================================
# ENVIRONMENT FILES
# ============================================================

# Local environment files containing configuration/secrets
.env
.env.*

# Keep the example environment file available in Git
!.env.example


# ============================================================
# EDITOR / IDE FILES
# ============================================================

# Visual Studio Code settings
.vscode/

# JetBrains IDE settings
.idea/


# ============================================================
# OPERATING SYSTEM FILES
# ============================================================

# macOS system file
.DS_Store

# Windows thumbnail cache
Thumbs.db


# ============================================================
# LOG FILES
# ============================================================

# Ignore application and tool log files
*.log


# ============================================================
# LOCAL CACHE / MODEL FILES
# ============================================================

# Local cache files
.cache/

# Local AI/model files
models/


# ============================================================
# PROJECT DOCUMENTATION
# ============================================================

# Keep the documentation folder tracked by Git.
#
# Project screenshots, documentation images, diagrams, and
# other documentation assets can be stored inside this folder.
#
# Examples:
#
#   doc/
#   ├── homepage.png
#   ├── search-page.jpg
#   ├── architecture.png
#   └── mobile-view.jpg
#
# PNG and JPG/JPEG files inside "doc/" are intentionally NOT
# ignored, so GitHub will include and display them.
#
# No ignore rule is added for the "doc/" folder.

